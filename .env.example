# Copy this file to .env and fill in a key. .env is git-ignored — never commit it.
# Keys are used only by the server route src/app/api/coach+api.ts; they never ship inside the app.

# For now: a free Google AI Studio key (https://aistudio.google.com/apikey).
# Free tier: Google may use what's sent to improve its products — test with made-up details, not real personal stories.
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.8-flash, and gemini-3.5-flash-lite for check-ins).
#GEMINI_MODEL=
#GEMINI_CHECKIN_MODEL=

# Later: Claude (https://platform.claude.com → Settings → API keys).
# If both keys are set, Gemini is used unless COACH_PROVIDER=claude.
#ANTHROPIC_API_KEY=
#COACH_PROVIDER=claude
